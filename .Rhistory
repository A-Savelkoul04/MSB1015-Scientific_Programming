as.data.frame() %>%
rownames_to_column(var = "Variable") %>%
select(Variable, PC1)
# 3. Find the top 20 most important variables based on absolute loading value for PC1
top_20_loadings <- loadings_df %>%
mutate(Abs_PC1 = abs(PC1)) %>%
arrange(desc(Abs_PC1)) %>%
head(20) %>%
# Reorder factor levels for proper plotting order
mutate(Variable = reorder(Variable, PC1))
if (RUN_PLOTS){
# 4. Plot the top 20 loadings using ggplot2
ggplot(top_20_loadings, aes(x = Variable, y = PC1, fill = PC1 > 0)) +
geom_col(show.legend = FALSE) +
coord_flip() + # Makes horizontal bar chart for readability
theme_minimal() +
labs(
title = "Top 20 Most Important Loadings for PC1",
x = "Original Variables",
y = "Loading Score (PC1)"
) +
scale_fill_manual(values = c("TRUE" = "#2b8cbe", "FALSE" = "#e34a33"))
} else {
cat("Plots not visualized due to RUN_PLOTS being set to FALSE.\n")
}
top_20_loadings$Variable
}
